# -----------------------------------------------------------------------------
# Escapd environment template. Copy to .env (app) and never commit real values.
# -----------------------------------------------------------------------------

# --- Expo app (PUBLIC: these ship inside the app binary) ---------------------
# Project URL: Supabase dashboard > Project Settings > Data API (or "Connect")
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Safe to ship: RLS protects data.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# RevenueCat public SDK keys (when billing is added)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Edge Function secrets (SERVER ONLY) -------------------------------------
# Set with: npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEYS are injected
# automatically in hosted Edge Functions; do not set them yourself.
#
# Shared secret for cron-invoked functions (generation-worker, storage-janitor).
# Generate: openssl rand -hex 32
CRON_SECRET=
# RevenueCat webhook Authorization header value (you choose it in RevenueCat).
REVENUECAT_WEBHOOK_AUTH=
# Optional but recommended: RevenueCat HMAC signing secret.
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# Gemini API key for generation-worker (sent as the x-goog-api-key header).
AI_PROVIDER_API_KEY=
# Optional model overrides (defaults shown). Set a *_FALLBACK_MODEL to empty to disable it.
# AI_PERCEPTION_MODEL=gemini-2.5-flash
# AI_PERCEPTION_FALLBACK_MODEL=gemini-3-flash-preview
# AI_PROSE_MODEL=gemini-3.1-pro-preview
# AI_PROSE_FALLBACK_MODEL=
